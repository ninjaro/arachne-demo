{
  "version": 1,
  "naming": "Figma-like Component/Variant/Instance",
  "componentSets": [
    {
      "id": "AppShell",
      "anatomy": ["NavigationRail", "PageWorkspace", "Inspector"],
      "variants": ["page=Evolution", "page=Browse"],
