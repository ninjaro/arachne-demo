      "metrics": { "heightApprox": 29, "horizontalPadding": "9–10px", "radius": 7, "inlineGap": 7 }
    },
    {
      "id": "DepthStepper",
      "anatomy": ["DirectionLabel", "Decrease", "Value", "Increase"],
      "variants": ["Earlier", "Later"],
      "metrics": { "controlRadius": 7, "segmentPadding": "5px 6–9px" }
    },
    {
      "id": "EvolutionCommandBar",
      "anatomy": ["SeedsLabel", "SeedTokens", "AddTrajectory", "Divider", "EarlierStepper", "LaterStepper", "Divider", "Filters", "Visibility", "Bundling"],
      "variants": ["closed-controls"],
      "metrics": { "height": 67, "padding": "10px 14px", "gap": 10 }
    },
    {
      "id": "SceneStatusBar",
      "anatomy": ["SceneCounts", "ChronologyNote", "DetailSelector", "ZoomStepper", "FitButton", "ResetAction"],
      "variants": ["Evolution"],
      "metrics": { "height": 57, "padding": "8px 14px", "gap": 14 }
    },
    {
      "id": "EvolutionCanvas",
      "anatomy": ["TimeAxis", "Grid", "TrajectoryLayer", "ExplicitRelationOverlay", "StationLayer", "LabelLayer", "SelectionOverlay"],
      "variants": ["dense-desktop"],
      "metrics": { "width": 1348, "height": 700, "axisHeight": 56 }
    },
    {
      "id": "TimeAxis",
      "anatomy": ["YearLabel", "VerticalGrid", "CompressedGap", "SelectedYearGuide"],
      "variants": ["ordinary-year", "selected-year", "compressed-gap"],
      "visual": "chronological order, nonmetric spacing; selected year is brighter and aligned to a dotted guide"
    },
    {
      "id": "Trajectory",
      "anatomy": ["SolidSegment", "BoundaryStub", "InlineLabel", "OptionalTerminal"],
      "variants": ["seed", "ordinary", "context-stub", "variable-strength"],
      "visual": "round-capped color path; secondary HTML geometry defines 3.5–11px segment widths while the image establishes variable width but no continuous taper; faded stubs use 0.22 opacity; terminal is a 15px outlined plus circle",
      "semanticConstraint": "width means membership significance only and does not change for hover, focus, or selection"
    },
    {
      "id": "Station",
      "anatomy": ["DarkKnockout", "VisibleGlyph", "WorkAnnotation"],
      "variants": ["single-work-ring", "interchange-vertical-cap", "aggregate-rounded-outline", "selected-interchange"],
      "visual": "single work is a dark point with colored ring; interchange is a pale vertical capsule; aggregate is a dark rounded outline; selected station adds white glow and label slab",
      "semanticConstraint": "an aggregate does not become an atomic interchange merely because different children support different tags"
    },
    {
      "id": "WorkAnnotation",
      "anatomy": ["Title", "DateKindCredit"],
      "variants": ["start-aligned", "centered", "end-aligned", "selected-with-backing-plate", "aggregate-count-in-metadata"],
      "metrics": { "title": "11.5px/600 Sans", "metadata": "10px Mono" }
    },
    {
      "id": "ExplicitRelation",
      "anatomy": ["CurvedDashedPath", "Arrowhead", "OptionalTypeLabel"],
      "variants": ["adapted-from", "influenced-by", "unlabelled"],
      "visual": "amber 1.7px path, 5px/4px dash, directional arrow; above trajectories and below station glyphs",
      "semanticConstraint": "exact work endpoints; visually prior to tag continuity without becoming an ordinary trajectory"
    },
    {
      "id": "TrajectoryLegend",
      "anatomy": ["TrajectoryTokenRow", "HiddenCount", "SymbolKeyRow"],
      "variants": ["seed-token", "ordinary-token", "hidden-token"],
      "metrics": { "height": 83, "padding": "9px 14px", "rowGap": 7 }
    },
    {
      "id": "InspectorShell",
      "anatomy": ["InspectorHeader", "InspectorContent"],
      "variants": ["work", "selection-set", "expanded", "collapsed-undepicted"],
      "metrics": { "width": 304, "headerHeight": 32, "headerPaddingApprox": "5px 14px", "contentPadding": 14, "contentGap": 14 }
    },
    {
      "id": "InspectorWork",
      "anatomy": ["CanonicalIdHeader", "WorkTitleMeta", "MediaSlot", "TrajectoryMemberships", "ContinuityCallout", "RelationCards", "FromHereActions", "NearbyAggregatesNote"],
      "variants": ["selected-interchange"],
      "visual": "section labels are 10px uppercase Mono; relation cards use amber border/accent; media is 16:10"
    },
    {
      "id": "RelationCard",
      "anatomy": ["DirectionAndType", "RelatedWork", "EvidenceSource"],
      "variants": ["outgoing", "incoming"],
      "visual": "dark warm surface, amber outline/type, compact three-line stack"
    },
    {
      "id": "BrowseCommandBar",
      "anatomy": ["SearchField", "KindFilter", "YearsFilter", "ActiveTagFilter", "SortControl"],
      "variants": ["dense-desktop"],
      "metrics": { "height": 52, "padding": "10px 14px", "gap": 10 }
    },
    {
      "id": "WorkTable",
      "anatomy": ["ResultStatus", "ColumnHeader", "WorkRows", "ResultFooter"],
      "columns": ["Selection", "Work", "Year", "Kind", "Credit", "Trajectories", "Relations"],
      "columnWidths": [26, 300, 66, 116, 150, "1fr", 96]
    },
    {
      "id": "WorkRow",
      "anatomy": ["SelectionBox", "Title", "OptionalHierarchyBadge", "Year", "Kind", "Credit", "TrajectoryMiniBars", "RelationCount"],
      "variants": ["default", "selected", "aggregate-labelled"],
      "metrics": { "height": 35, "padding": "9px 14px" }
    },
    {
      "id": "InspectorSelectionSet",
      "anatomy": ["SelectionCountHeader", "DateList", "SharedTrajectoryRows", "SeedEvolutionButton", "PinAllButton", "BehaviorNote"],
      "variants": ["three-works-selected"]
    },
    {
      "id": "ActionButton",
      "anatomy": ["Label"],
      "variants": ["strong-surface", "neutral-surface", "text-action", "disabled-undepicted"],
      "metrics": { "padding": 8, "radius": 7 }
    }
